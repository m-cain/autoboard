    "generate": "tsc -b && node dist/generate-json-schema.js"
  },
  "dependencies": {
    "json-schema-to-ts": "^3.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "^7.0.0",
    "vitest": "^4.1.0"
  }
}
