{
  "$ref": "#/definitions/ProjectList",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Project": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "inserted_at": {
          "format": "date-time",
          "type": "string"
        },
        "key": {
          "maxLength": 8,
          "minLength": 2,
          "pattern": "^[A-Z][A-Z0-9]*$",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "state": {
          "enum": [
            "active",
            "archived"
          ],
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "id",
        "key",
        "name",
        "description",
        "state",
        "revision",
        "inserted_at",
        "updated_at"
      ],
      "type": "object"
    },
    "ProjectList": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "items": {
            "$ref": "#/definitions/Project"
          },
          "type": "array"
        },
        "archived": {
          "items": {
            "$ref": "#/definitions/Project"
          },
          "type": "array"
        }
      },
      "required": [
        "active",
        "archived"
      ],
      "type": "object"
    }
  }
}
