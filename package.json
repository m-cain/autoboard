{
  "name": "autoboard",
  "private": true,
  "packageManager": "pnpm@11.14.0",
  "scripts": {
    "check": "pnpm format:check && pnpm -r check && go vet ./...",
    "format:prettier": "prettier . --write",
    "format:prettier:check": "prettier . --check",
    "format:go": "gofmt -w cmd internal",
    "format:go:check": "test -z \"$(gofmt -l cmd internal)\"",
    "format": "pnpm format:prettier && pnpm format:go",
    "format:check": "pnpm format:prettier:check && pnpm format:go:check",
    "test": "pnpm -r --filter '!@autoboard/e2e' test && go test ./...",
    "coverage": "pnpm coverage:typescript && pnpm coverage:go",
    "coverage:go": "node scripts/check-go-coverage.mjs",
    "coverage:typescript": "pnpm --filter @autoboard/contracts coverage && pnpm --filter @autoboard/web coverage",
    "lint:go": ".tools/bin/golangci-lint config verify && .tools/bin/golangci-lint run ./...",
    "test:e2e": "pnpm --filter @autoboard/e2e test",
    "build:contracts": "go generate ./internal/contracts && pnpm --filter @autoboard/contracts build",
    "check:contracts": "go run ./cmd/autoboard-schema --check packages/contracts/generated-go packages/contracts/src/generated/browser-schemas.ts",
    "build:web": "pnpm --filter @autoboard/web build",
    "build:daemon": "go run ./cmd/autoboard-embed && go build -trimpath -ldflags \"-X main.version=0.1.0\" -o dist/autoboard ./cmd/autoboard",
    "build": "pnpm build:contracts && pnpm build:web && pnpm build:daemon",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "prettier": "3.9.5"
  }
}
